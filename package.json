{
  "name": "trackrail",
  "version": "1.0.0",
  "description": "TrackRail - Real-time Indian railway journey tracking & travel intelligence SaaS",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npx tsc -b --prefix frontend"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
